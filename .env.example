# Required for account sessions (use any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: local file store path for dev/self-hosted (defaults to ./data/vault-tracker-store.json)
# DATABASE_PATH=./data/vault-tracker-store.json

# Persistent accounts + sync on Vercel — use ONE of these options:
#
# Option A: Vercel Storage / KV (auto-injected when you link a KV database)
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Option B: Upstash directly
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
#
# Without either option, Vercel uses /tmp (ephemeral — wiped on redeploy).

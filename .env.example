# Required for account sessions (use any long random string)
SESSION_SECRET=change-me-to-a-long-random-string

# Optional: local file store path for dev/self-hosted (defaults to ./data/vault-tracker-store.json)
# On Vercel without Redis, /tmp is used temporarily — add Upstash for persistent storage.
# DATABASE_PATH=./data/vault-tracker-store.json

# Required on Vercel for persistent accounts + sync (free tier at upstash.com)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
